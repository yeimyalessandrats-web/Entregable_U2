<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: white" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.entregable_u2.controller.PasajeroFormController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>
    <children>
        <Label fx:id="lblTitulo" text="Datos del pasajero" textFill="#014074">
            <font><Font name="System Bold" size="18.0"/></font>
        </Label>
        <Separator prefWidth="200.0"/>
        <GridPane hgap="10.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="110.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="230.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label text="Nombres"/>
                <TextField fx:id="txtNombres" GridPane.columnIndex="1"/>
                <Label text="Apellidos" GridPane.rowIndex="1"/>
                <TextField fx:id="txtApellidos" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="DNI" GridPane.rowIndex="2"/>
                <TextField fx:id="txtDni" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Edad" GridPane.rowIndex="3"/>
                <TextField fx:id="txtEdad" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Telefono" GridPane.rowIndex="4"/>
                <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label text="Direccion" GridPane.rowIndex="5"/>
                <TextField fx:id="txtDireccion" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                <Label text="Fecha Nacimiento" GridPane.rowIndex="6"/>
                <DatePicker fx:id="dpFechaNacimiento" GridPane.columnIndex="1" GridPane.rowIndex="6" maxWidth="Infinity"/>
            </children>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="31.0"
                        prefWidth="100.0" styleClass="button-action-delete" text="Cancelar"/>
                <Button mnemonicParsing="false" onAction="#handleSaved" prefHeight="31.0"
                        prefWidth="100.0" styleClass="button-action-edit" text="Guardar"/>
            </children>
        </HBox>
    </children>

</VBox>
