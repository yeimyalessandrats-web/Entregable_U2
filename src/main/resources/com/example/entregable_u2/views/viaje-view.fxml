<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: #F7F7F7" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.entregable_u2.controller.ViajeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Gestion de Viajes" textFill="#014074">
                    <font><Font name="System Bold" size="20.0"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleNew" styleClass="button-login" text="+ NUEVO"/>
            </children>
        </HBox>

        <TableView fx:id="tableViaje" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="50.0" text="N°"/>
                <TableColumn fx:id="ColId" prefWidth="50" text="ID" visible="false"/>
                <TableColumn fx:id="ColOrigen" prefWidth="110" text="Origen"/>
                <TableColumn fx:id="ColDestino" prefWidth="110" text="Destino"/>
                <TableColumn fx:id="ColSalida" prefWidth="90" text="Salida"/>
                <TableColumn fx:id="ColLlegada" prefWidth="90" text="Llegada"/>
                <TableColumn fx:id="ColConductor" prefWidth="150" text="Conductor"/>
                <TableColumn fx:id="ColVehiculo" prefWidth="130" text="Vehiculo"/>
                <TableColumn fx:id="ColCapacidad" prefWidth="80" text="Capacidad"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleEdit" styleClass="button-action-edit" text="EDITAR"/>
                <Button mnemonicParsing="false" onAction="#handleDelete" styleClass="button-action-delete" text="ELIMINAR"/>
            </children>
        </HBox>
    </children>

</VBox>
