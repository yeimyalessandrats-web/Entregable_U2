<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: #F7F7F7" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.entregable_u2.controller.PasajeroController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Gestion de Pasajeros" textFill="#014074">
                    <font><Font name="System Bold" size="20.0"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleNew" styleClass="button-login" text="+ NUEVO"/>
            </children>
        </HBox>

        <TableView fx:id="tablePasajero" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="50.0" text="N°"/>
                <TableColumn fx:id="ColId" prefWidth="50" text="ID" visible="false"/>
                <TableColumn fx:id="ColNombres" prefWidth="130" text="Nombres"/>
                <TableColumn fx:id="ColApellidos" prefWidth="130" text="Apellidos"/>
                <TableColumn fx:id="ColDni" prefWidth="90" text="DNI"/>
                <TableColumn fx:id="ColEdad" prefWidth="60" text="Edad"/>
                <TableColumn fx:id="ColTelefono" prefWidth="100" text="Telefono"/>
                <TableColumn fx:id="ColDireccion" prefWidth="150" text="Direccion"/>
                <TableColumn fx:id="ColFechaNac" prefWidth="100" text="Fecha Nac."/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleEdit" styleClass="button-action-edit" text="EDITAR"/>
                <Button mnemonicParsing="false" onAction="#handleDelete" styleClass="button-action-delete" text="ELIMINAR"/>
            </children>
        </HBox>
    </children>

</VBox>
